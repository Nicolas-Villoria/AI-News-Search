# Local Docker Compose (see docker-compose.yml)
DATABASE_URL=postgresql://ainews:ainews_dev@localhost:5432/ainews

# Supabase — Connect → Session pooler (IPv4-friendly). Avoid db.*.direct host on home Wi‑Fi (often IPv6-only).
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# CORS — comma-separated list of allowed origins (default: http://localhost:3000)
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# API key for protected endpoints like /pipeline/run (optional — if unset, no key is required)
# API_KEY=your-secret-key-here
